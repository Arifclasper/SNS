# Copy to .env.local for local development, and set the same keys in your
# Vercel project settings for production.

# Admin console password. Required. Production requires 16+ characters.
ADMIN_PASSWORD=

# Random string used to sign the admin JWT. Required, 32+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Session cookie settings.
SESSION_COOKIE_NAME=sns_session
SESSION_MAX_AGE_SECONDS=43200

# Base URL used only by the verification scripts. For local development use
# http://localhost:3000; when running the scripts against a deployment, set
# the production URL instead. The application itself does not read this.
APP_BASE_URL=http://localhost:3000
# Port used by `next dev` / `next start` (Next.js defaults to 3000).
# Do not set this in Vercel.
PORT=3000

# MongoDB Atlas
# Connection string for the Atlas cluster. URL-encode special characters in
# the password (for example @ -> %40).
MONGODB_URI=
# Or set the pieces separately (used only when MONGODB_URI is empty):
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=your-cluster.mongodb.net
# Optional direct seed list (comma-separated host:port). Use this when SRV
# lookups are blocked by a local DNS resolver; takes precedence over MONGODB_HOST.
MONGODB_HOSTS=
# Database name inside the cluster.
MONGODB_DB=SNS_Collection
# Connection pool size and server-selection timeout (milliseconds).
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Cloudinary (uploaded product / colour / hero images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder inside Cloudinary. Defaults to "sns-shoes".
CLOUDINARY_FOLDER=sns-shoes
# Alternatively, use a single connection URL instead of the three keys above:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Optional: set to "false" to create an empty database instead of the demo
# catalogue on first boot.
SEED_DEMO_DATA=true

# IANA timezone for order-number days and displayed dates.
STORE_TIME_ZONE=Asia/Dhaka
# Locales used to format numbers and dates.
NEXT_PUBLIC_STORE_NUMBER_LOCALE=en-US
NEXT_PUBLIC_STORE_DATE_LOCALE=en-GB
STORE_ISO_LOCALE=en-CA

# Store identity shown across the storefront, admin console and receipts.
NEXT_PUBLIC_STORE_NAME=SNS Collection
NEXT_PUBLIC_STORE_SHORT_NAME=SNS
NEXT_PUBLIC_STORE_DESCRIPTION=Ballerina shoes, party flats and sweet little extras for girls — soft steps, made for twirling.
NEXT_PUBLIC_STORE_LOGO=/logo.jpeg
NEXT_PUBLIC_STORE_LANG=en
NEXT_PUBLIC_STORE_PHONE=+8801700000000
NEXT_PUBLIC_STORE_PHONE_DISPLAY=+880 1700 000000

# Currency and delivery defaults.
NEXT_PUBLIC_CURRENCY_SYMBOL=৳
NEXT_PUBLIC_CURRENCY_CODE=BDT
CURRENCY_ASCII_FALLBACK=Tk
NEXT_PUBLIC_DELIVERY_FEE_DHAKA=80
NEXT_PUBLIC_DELIVERY_FEE_OUTSIDE=150
DEFAULT_SHIPPING_FEE=80
DEFAULT_FREE_SHIPPING_THRESHOLD=3000

# Order codes and stock defaults.
ORDER_CODE_PREFIX=SNS
DEFAULT_LOW_STOCK_THRESHOLD=5
MAX_QTY_PER_LINE=20

# Courier options shown on the admin order page (comma-separated).
COURIERS=Pathao,Steadfast,RedX,Paperfly,Sundarban,Other

# Upload limits (bytes and comma-separated MIME types).
NEXT_PUBLIC_MAX_UPLOAD_BYTES=4194304
NEXT_PUBLIC_UPLOAD_ACCEPT=image/jpeg,image/png,image/webp,image/gif,image/avif
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif

# List sizes.
STOREFRONT_PAGE_SIZE=12
CATALOG_PAGE_SIZE=24
ADMIN_PRODUCTS_PAGE_SIZE=20
ADMIN_ORDERS_PAGE_SIZE=20
ADMIN_STOCK_PAGE_SIZE=25
HOMEPAGE_PRODUCT_PICKER_LIMIT=200
RELATED_PRODUCTS_LIMIT=4
NEW_ARRIVALS_LIMIT=8
